{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      ".git/**",
      ".firebase/**",
      ".agents/**",
      ".claude/**",
      "**/node_modules/**",
      "firebase-debug.log",
      ".server-*.log",
      "AGENTS.md",
      "CLAUDE.md",
      "**/functions/**",
      "README.md",
      "README_EN.md",
      "LICENSE",
      "index.js",
      "tools/**",
      "old/**",
      "screenshots/**",
      "docs/**",
      "design.md",
      "*.csv",
      "**/*.csv",
      "**/*.md",
      "**/*.mjs",
      "**/*.py",
      "**/*.bat",
      "**/*.sh",
      "**/*.json",
      "**/*.map",
      "**/*.txt",
      "**/*.zip",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.svg",
      "**/*.ico",
      "**/*.woff",
      "**/*.woff2"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
